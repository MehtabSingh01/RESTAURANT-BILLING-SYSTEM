pipeline {
    agent any

    environment {
        DOCKER = 'C:\\Users\\mehta\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'
        DOCKER_COMPOSE = 'C:\\Users\\mehta\\AppData\\Local\\Programs\\DockerDesktop\\resources\\cli-plugins\\docker-compose.exe'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Docker') {
            steps {
                bat '''
                    "%DOCKER%" --version
                    "%DOCKER_COMPOSE%" version
                    "%DOCKER%" ps
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                bat '''
                    cd RESTAURANT-BILLING-SYSTEM_
                    "%DOCKER%" build -t restaurant-billing:latest .
                '''
            }
        }

        stage('Deploy MySQL') {
            steps {
                bat '''
                    cd RESTAURANT-BILLING-SYSTEM_
                    "%DOCKER_COMPOSE%" -f docker-compose.yml up -d mysql
                '''
            }
        }

        stage('Verify MySQL') {
            steps {
                bat '''
                    "%DOCKER%" ps
                    "%DOCKER%" volume ls
                '''
            }
        }
    }

    post {
        success {
            echo '=========================================='
            echo 'RESTAURANT BILLING SYSTEM DEPLOYMENT OK'
            echo '=========================================='
            echo 'Docker image built successfully.'
            echo 'MySQL container started.'
            echo 'Docker volume verified.'
        }

        failure {
            echo '=========================================='
            echo 'DOCKER DEPLOYMENT FAILED'
            echo '=========================================='
            echo 'Check the Console Output for the error.'
        }
    }
}