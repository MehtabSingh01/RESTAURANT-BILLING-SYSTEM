pipeline {
    agent any

    environment {
        DOCKER = 'C:\\Users\\mehta\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Docker') {
            steps {
                bat '''
                    "%DOCKER%" --version
                    "%DOCKER%" compose version
                    "%DOCKER%" ps
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                bat '''
                    cd RESTAURANT-BILLING-SYSTEM_
                    "%DOCKER%" build -t restaurant-billing:latest .
                '''
            }
        }

        stage('Deploy MySQL') {
            steps {
                bat '''
                    cd RESTAURANT-BILLING-SYSTEM_
                    "%DOCKER%" compose up -d mysql
                '''
            }
        }

        stage('Start Application') {
            steps {
                bat '''
                    cd RESTAURANT-BILLING-SYSTEM_
                    "%DOCKER%" compose up -d restaurant-app
                '''
            }
        }

        stage('Verify Containers') {
            steps {
                bat '''
                    "%DOCKER%" ps
                    "%DOCKER%" volume ls
                '''
            }
        }
    }

    post {
        success {
            echo '=========================================='
            echo 'RESTAURANT BILLING SYSTEM DEPLOYED'
            echo 'Docker image built successfully.'
            echo 'MySQL container started.'
            echo 'Application container started.'
            echo 'Database volume is preserved.'
            echo '=========================================='
        }

        failure {
            echo '=========================================='
            echo 'DOCKER DEPLOYMENT FAILED'
            echo 'Check the Console Output for the error.'
            echo '=========================================='
        }
    }
}